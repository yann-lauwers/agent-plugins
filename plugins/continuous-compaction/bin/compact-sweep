#!/usr/bin/env python3
"""Compact the sessions that are too full to be left alone, from outside them.

## Why this exists next to `compact-at-seam`

The hook composes and types at a `Stop`, which means it can only ever act on a
session that is still being worked. A session that filled up and was then parked
never ends another turn, so no `Stop` fires and nothing reaches it — measured
2026-09-08, six of nine sessions past the 60% floor were in exactly that state,
one of them at 97% since 07:40. The hook is not the wrong instrument for them; it
is an instrument that cannot be pointed at them at all.

So this sweeps from the outside: it enumerates sessions by fill, composes through
the SAME `hook_compact_focus` the hook uses, leaves the SAME handoff the far side
reads, and types the same `/compact <focus>`. `postcompact-resume` then fires
inside the target session and types the composed resume, exactly as it does after
a hook-typed compaction. Nothing here re-implements the seam; it re-aims it.

## What it refuses to do

Typing into the wrong pane would put a `/compact` into somebody's live work, so
resolution is required to be unambiguous:

- A session resolves to a pane through `/tmp/.ccseat-<session>`, which its own
  status line writes because it is the only process holding both facts. Falling
  back to the transcript's directory is allowed only when exactly one workspace
  stands there; two is AMBIGUOUS and is skipped with a reason, never guessed.
- A session whose transcript cannot be found is skipped.
- On an unattended pass, a session whose last recorded Stop reported dispatched
  work in flight is skipped until its transcript shows every task that row named
  has ended. The hook reads the live `background_tasks` out of its Stop payload;
  from outside, the row says what was running and the transcript's
  `<task-notification>` says when each task finished. Written after this gap
  typed a `/compact` into a session running 8 teammates on 2026-09-08, which the
  hook had been refusing correctly all afternoon.
- `--dry-run` is the default. Typing requires `--go`, deliberately.
- An unattended pass carries a cooldown, a 3-sweep budget and an inert rule, so a
  session whose swept compaction freed too little is not retried forever. A session
  named with `--session` is exempt from all three AND from the dispatch reading,
  which it reports instead of obeying: asking for one IS the decision, and the
  panel button that names a session has no way to pass `--ignore-dispatch`.
- A typed `/compact` is PENDING, exactly as it is for `compact-at-seam`: the
  budget and the cooldown are not spent until a later pass settles it against
  the transcript, through the same `hook_compact_settle` classifier. While a
  sweep is pending, an unattended pass leaves the session alone rather than
  typing a second one over it — a named `--session` sweep is exempt, the same
  way it is exempt from the budget and the cooldown themselves.
"""
import argparse
import glob
import json
import os
import re
import subprocess
import sys
import time

# This file ships inside the plugin, beside the hooks it re-aims, so its own
# copies of the composer and the typist are the ones it must load — a machine
# carrying an older hand-installed set under ~/.claude/hooks would otherwise
# compose with one and type with the other.
PLUGIN_ROOT = os.environ.get("CLAUDE_PLUGIN_ROOT") or os.path.dirname(
    os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "hooks", "lib"))
# The host's hook engine, when this machine has one: `hook_decisions` and
# `hook_run` live there and nowhere else, and every import of them degrades to
# None without it.
HOOKS = os.path.expanduser("~/.claude/hooks")
sys.path.append(os.path.join(HOOKS, "lib"))
try:
    import hook_compact_boundary as boundary_lib
    import hook_compact_focus as focus_lib
    import hook_compact_handoff as handoff_lib
    import hook_compact_settle as settle_lib
except Exception as exc:                       # the seam's own halves are missing
    sys.stderr.write("compact-sweep: cannot import the hook libs (%r)\n" % exc)
    sys.exit(1)

BLOCKING_KINDS = ("agent", "subagent", "workflow", "teammate")

STATE = os.path.join(os.environ.get("HOOK_STATE_ROOT",
                                    os.path.expanduser("~/.claude/state")),
                     "compact-sweep")
# A session compacted a moment ago must not be compacted again on the next pass.
# The fill threshold is a PARTIAL guard — a compaction usually drops a session
# below it, so it self-excludes — and partial is the wrong standard for something
# that may run unattended on a schedule. What partial misses is precisely the case
# worth guarding: a compaction that did NOT lower the fill, which would otherwise
# be retried on every pass forever. `compact-at-seam` carries a cooldown, a fire
# budget and an inert rule for the same reason; this is that discipline, on the
# route that can reach sessions the hook cannot.
#
# A NAMED session is exempt. Asking for a specific session IS the decision, and a
# cooldown that refuses a direct request would be answering a question nobody
# asked — the guard exists for the unattended sweep, not for the person.
COOLDOWN_S = int(os.environ.get("COMPACT_SWEEP_COOLDOWN_S", "1800"))
MAX_FIRES = int(os.environ.get("COMPACT_SWEEP_MAX_FIRES", "3"))
PROGRESS_POINTS = 10        # a swept compaction freeing fewer fill points is inert


def _sweep_state_path(session):
    safe = "".join(c for c in str(session) if c.isalnum() or c in "-_")[:64] or "unknown"
    return os.path.join(STATE, safe + ".json")


DECISIONS = os.path.join(os.environ.get("HOOK_STATE_ROOT",
                                        os.path.expanduser("~/.claude/state")),
                         "hook-decisions.jsonl")
TERMINAL = re.compile(r"<status>(?:completed|failed|killed|stopped)</status>")
TASK_ID = re.compile(r"<task-id>([A-Za-z0-9]+)</task-id>")
LAUNCH = re.compile(r"Task ID: ([A-Za-z0-9]+)(?: Summary: ([^\n]{1,160}))?|agentId: ([A-Za-z0-9]+)")


def _notification_text(row):
    """The body of a task-notification the HARNESS wrote, or None.

    Three shapes carry one, measured over 300 transcripts: a `user` row whose
    `origin.kind` is `task-notification` (971), a queue `enqueue` (1508) and a
    `queued_command` attachment (589). The same text inside a tool result, a
    file snippet or an assistant turn is something a tool or the model wrote —
    a grep of the transcript quotes ids of live tasks — so it never counts."""
    kind = row.get("type")
    if kind == "user" and (row.get("origin") or {}).get("kind") == "task-notification":
        text = (row.get("message") or {}).get("content")
    elif kind == "queue-operation" and row.get("operation") == "enqueue":
        text = row.get("content")
    elif kind == "attachment" and (row.get("attachment") or {}).get("type") == "queued_command":
        text = row["attachment"].get("prompt")
    else:
        return None
    if isinstance(text, str) and text.lstrip().startswith("<task-notification>"):
        return text
    return None


def _text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(_text_of(p.get("content") if p.get("type") == "tool_result"
                                  else p.get("text")) for p in content if isinstance(p, dict))
    return ""


def _task_scan(tpath, since):
    """(ids a notification ENDED at or after `since`, {id: launch summary}) in
    one pass. A notification without a terminal status is a progress event — a
    Monitor's — and ends nothing."""
    ended, launched = set(), {}
    try:
        lines = open(tpath, errors="replace")
    except Exception:
        return ended, launched
    for line in lines:
        if "task-notification" not in line and "Task ID:" not in line \
                and "agentId:" not in line:
            continue
        # PER ROW. A transcript holds shapes this parser has never seen — one
        # `user` row whose `message` is a bare string is enough — and a scan that
        # abandons the file on the first of them loses every later notification,
        # which reads exactly like a task that never ended.
        try:
            row = json.loads(line)
            text = _notification_text(row)
            if text is not None:
                ts = boundary_lib.epoch(row.get("timestamp"))
                if ts is not None and ts >= since and TERMINAL.search(text):
                    ended.update(TASK_ID.findall(text))
                continue
            if row.get("type") != "user":
                continue
            # A subagent launch says only `agentId: <id>`; its description is in
            # the row's own `toolUseResult`. Measured over the 300 most recent
            # transcripts: 263 launches in that shape, 31 a bare `Task ID:`, and
            # one carrying `Summary:` — so the summary alone loses nearly all of
            # them, and the focus then names a task it cannot describe.
            described = (row.get("toolUseResult") or {}).get("description") \
                if isinstance(row.get("toolUseResult"), dict) else None
            for m in LAUNCH.finditer(_text_of((row.get("message") or {}).get("content"))):
                launched.setdefault(m.group(1) or m.group(3),
                                    (m.group(2) or described or "").strip())
        except Exception:
            continue
    return ended, launched


def dispatched_recently(session, tpath):
    """(a reason to stand off this session or None, the tasks still pending).

    The pending tasks are handed to the composer whether or not the caller
    stands off, so a compaction typed over live dispatch — a named session —
    keeps why each task was started, as the hook's own fires do.

    The hook decides this from the live `background_tasks` in its Stop payload.
    Nothing outside the session can read that, so this reads the last row the
    hook wrote. That row is a reading from the past, and the hook does not write
    one on every Stop, so "no later row" is never evidence the work is still
    running. Ageing the row out by the clock would invent the reassuring answer,
    which a first attempt here did: a 1800s window let a session running 8
    teammates through because its last reading was 84 minutes old.

    What does decay is the transcript: every finished task arrives there as a
    harness-written `<task-notification>` with a terminal status. So the row
    stands until the transcript shows each id it named ending after it. A row
    that named fewer ids than it counted — no id, or a list cut short — cannot be
    proven finished, and stands, saying that is why."""
    latest = None
    try:
        for line in open(DECISIONS, errors="replace"):
            try:
                row = json.loads(line)
            except Exception:
                continue
            if row.get("check") != "compact-at-seam":
                continue
            if row.get("session") != session:
                continue
            # THE LAST ROW CARRYING DISPATCH FACTS, never the last row of any
            # kind. A release does not end the hook's turn — it goes on to compose
            # and fire, and every exit after it writes its own row — so a
            # `released` row is never a session's last one and reading only the
            # last row made that branch unreachable. It is the docstring's own
            # rule applied consistently: the log records a STATE, so a later
            # unrelated row is no more evidence the work ended than no row is.
            if row.get("verdict") == "released" or \
                    "dispatched work in flight" in (row.get("detail") or ""):
                latest = row
    except Exception:
        return None, []                  # no log is no opinion, never "it is free"
    if latest is None:
        return None, []
    detail = latest.get("detail") or ""
    # A `released` row carries the same facts and means the hook's own hold ran
    # out: the work is still in flight, so its tasks are still owed to the
    # composer, and there is nothing left to stand off for.
    released = latest.get("verdict") == "released"
    n = re.search(r"\bn=(\d+)", detail)
    counted = int(n.group(1)) if n else None
    listed = re.search(r"\bids=(\S+)", detail)
    # 8 characters is the shortest whole id the harness mints; anything shorter
    # in the list is a `?` for a task with no id, or a tail the log's cap cut.
    ids = [i for i in (listed.group(1).split(",") if listed else []) if len(i) >= 8]
    since = boundary_lib.epoch(latest.get("ts"))
    ended, launched = _task_scan(tpath, since if since is not None else float("inf")) \
        if tpath else (set(), {})
    pending = [{"id": i, "description": next(
        (s for k, s in launched.items() if k.startswith(i) and s),
        "a dispatched task (%s) still in flight at the last Stop" % i)}
        for i in ids if not any(d.startswith(i) for d in ended)]
    if released:
        return None, pending
    if not ids or counted != len(ids):
        why = ("it named %d of %s task(s) it counted, so their end cannot be proven"
               % (len(ids), "?" if counted is None else counted))
    elif not tpath:
        why = "no transcript was found to show it ended"
    elif since is None:
        why = "its own timestamp does not parse, so nothing can be read as later"
    elif all(any(d.startswith(i) for d in ended) for i in ids):
        return None, []
    else:
        why = "the transcript shows no task-notification ending it since"
    when = str(latest.get("ts", ""))[11:19] or "?"
    return ("its last recorded Stop (%s) reported %s, and %s"
            % (when, detail.split("why=")[-1][:52], why)), pending


def sweep_state(session):
    try:
        with open(_sweep_state_path(session)) as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def _write_sweep_state(session, st):
    try:
        os.makedirs(STATE, exist_ok=True)
        tmp = _sweep_state_path(session) + ".%d" % os.getpid()
        with open(tmp, "w") as fh:
            json.dump(st, fh)
        os.replace(tmp, _sweep_state_path(session))
    except Exception:
        pass


def settle_pending(session, transcript):
    """Settle a fire this sweeper typed earlier, against the same classifier
    `compact-at-seam` settles its own Stop-typed fires with — one copy of what a
    landed, lost or unconfirmed `/compact` looks like, whichever route typed it.

    Returns (outcome, detail) from `hook_compact_settle.settle`, or (None, None)
    when there is nothing pending. A resolved outcome is written back to the
    sweep's own state before this returns, so a caller reading `sweep_state`
    right after sees the settled budget and cooldown, never the stale pending
    record."""
    st = sweep_state(session)
    if not isinstance(st.get("pending"), dict):
        return None, None
    outcome, detail = settle_lib.settle(st, transcript, time.time(), COOLDOWN_S)
    if outcome in ("landed", "lost", "unconfirmed"):
        _write_sweep_state(session, st)
        if outcome != "landed":
            handoff_lib.clear(session)
    return outcome, detail


def _inert_reason(basis):
    return ("inert — its last swept compaction freed %s fill points (%s → %s tokens), "
            "so sweeping again would loop"
            % (basis.get("freed"), basis.get("pre"), basis.get("post")))


def held_back(session, pct, tpath):
    """A reason to skip this session on an unattended pass, or None.

    Inert is judged once per sweep, from the boundary that compaction wrote in
    the transcript — never from the fill at the next pass, which after a landed
    compaction and a refill reads exactly like no progress. An `inert` carrying
    no basis came from that fill rule and no longer binds."""
    st = sweep_state(session)
    basis, _, changed = boundary_lib.inert(st, tpath, PROGRESS_POINTS)
    if changed:
        _write_sweep_state(session, st)
    if basis:
        return _inert_reason(basis)
    if st.get("fires", 0) >= MAX_FIRES:
        return "budget spent (%d sweeps)" % st["fires"]
    last = st.get("last_ts", 0)
    if last and time.time() - last < COOLDOWN_S:
        return "cooldown, swept %ds ago" % int(time.time() - last)
    return None


def fill(session):
    """(percent, age_seconds) from the file the status line writes, or (None, None)."""
    path = "/tmp/.ccctx-%s" % session
    try:
        age = time.time() - os.path.getmtime(path)
        first = open(path).readline().strip()
        return float(first.split("\t")[0]), age
    except Exception:
        return None, None


def last_assistant_text(path, tail_bytes=400000):
    """The session's own closing message — what the composer reads.

    Read from the END: a long transcript is tens of megabytes and only the last
    assistant turn matters. A partial first line after seeking is dropped."""
    try:
        size = os.path.getsize(path)
        with open(path, errors="replace") as fh:
            if size > tail_bytes:
                fh.seek(size - tail_bytes)
                fh.readline()
            lines = fh.readlines()
    except Exception:
        return ""
    for line in reversed(lines):
        try:
            row = json.loads(line)
        except Exception:
            continue
        msg = row.get("message") or {}
        if row.get("type") != "assistant" or not isinstance(msg, dict):
            continue
        content = msg.get("content")
        if isinstance(content, str) and content.strip():
            return content
        if isinstance(content, list):
            parts = [c.get("text", "") for c in content
                     if isinstance(c, dict) and c.get("type") == "text"]
            joined = "\n".join(p for p in parts if p).strip()
            if joined:
                return joined
    return ""


def cwd_of(path):
    """The working directory the transcript's own rows record."""
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except Exception:
                    continue
                if row.get("cwd"):
                    return row["cwd"]
    except Exception:
        pass
    return None


def workspaces():
    try:
        out = subprocess.run(["cmux", "workspace", "list", "--json"],
                             capture_output=True, text=True, timeout=20)
        if out.returncode != 0:
            return None
        data = json.loads(out.stdout)
    except Exception:
        return None
    return data if isinstance(data, list) else data.get("workspaces") or []


def _norm(text):
    return " ".join((text or "").split())[:90]


def last_user_text(path, tail_bytes=800000):
    """The last message this session received, normalised for comparison."""
    try:
        size = os.path.getsize(path)
        with open(path, errors="replace") as fh:
            if size > tail_bytes:
                fh.seek(size - tail_bytes)
                fh.readline()
            lines = fh.readlines()
    except Exception:
        return None
    for line in reversed(lines):
        try:
            row = json.loads(line)
        except Exception:
            continue
        if row.get("type") != "user":
            continue
        content = (row.get("message") or {}).get("content")
        if isinstance(content, str) and content.strip():
            return _norm(content)
        if isinstance(content, list):
            for part in content:
                if (isinstance(part, dict) and part.get("type") == "text"
                        and part.get("text", "").strip()):
                    return _norm(part["text"])
    return None


def seat_of(session):
    """(surface_id, tmux_pane) this session's own status line recorded, or (None, None).

    `~/.claude/statusline.sh` runs INSIDE the session and inherits its pane from the
    environment, so it is the only process holding both the session id and the seat
    at once. Everything else is a guess: a transcript is appended and closed so no
    process holds it open, and a directory identifies nothing — 16 cmux workspaces
    stand in the nexus base checkout."""
    try:
        parts = open("/tmp/.ccseat-%s" % session).readline().rstrip("\n").split("\t")
    except Exception:
        return None, None
    surf = parts[0].strip() if parts else ""
    pane = parts[1].strip() if len(parts) > 1 else ""
    return (surf or None), (pane or None)


def surface_for(session, cwd, spaces, siblings, human=None):
    """(kind, target, note). The recorded seat first; the directory only as a
    fallback, and only when it is unambiguous IN BOTH DIRECTIONS.

    `siblings` is how many live sessions share this cwd. One workspace and two
    sessions is exactly as ambiguous as two workspaces and one session, and it is
    the direction that reads as resolved: measured 2026-09-08, one workspace stood
    in `worktrees/nexus/nex-3734` while two sessions named it as their cwd, so a
    one-sided check would have typed two DIFFERENT `/compact` lines into that one
    pane and the second would have carried the wrong session's brief."""
    surf, pane = seat_of(session)
    if surf:
        return "cmux", surf, None
    if pane:
        return "tmux", pane, None
    # THERE IS NO SECOND TIER, and the reason is the object model rather than
    # effort. A cmux WORKSPACE contains one or more PANES, and a pane one or more
    # SURFACES; a Claude session is a surface. Observed 2026-09-08, one workspace
    # and one pane holding two:
    #
    #     workspace:76 F08B5755…  pane:76 FE1A70C1…  surface:85  1B2E18B0…
    #     workspace:76 F08B5755…  pane:76 FE1A70C1…  surface:168 D391230E…
    #
    # So `cmux workspace list` cannot identify a session even when it returns
    # exactly one row: three sessions stand in `worktrees/nexus/nex-3734` and one
    # workspace does. Worse, `cmux send --workspace` delivers to whichever surface
    # is ACTIVE there — so a workspace-level fallback does not merely fail to
    # resolve, it types into a different session inside the right workspace, which
    # is the exact accident this tool must never have.
    #
    # The surface id is therefore the only safe target, and `/tmp/.ccseat-` is the
    # only place it is recorded, because the status line is the one process holding
    # both the session id and the surface it inherited. A session that has never
    # rendered has no seat, and the honest answer is that it is unreachable rather
    # than a guess dressed as a resolution.
    hint = ""
    if spaces is not None:
        here = [w for w in spaces if (w.get("current_directory") or "") == cwd]
        hint = " (%d workspace(s) and %d live session(s) stand in %s, and a " \
               "workspace can hold several sessions, so neither identifies this " \
               "one)" % (len(here), siblings, cwd)
    return (None, None,
            "no recorded seat — this session has not rendered its status line since "
            "`.ccseat-` was introduced, so its surface id is unknown%s" % hint)


def type_into(kind, target, text):
    """Text then Enter, as two calls — a TUI commonly drops a newline arriving in
    the same write as the text it terminates, which reads as typed-but-never-sent.

    Only a SURFACE is ever targeted. A workspace holds several of them and
    `--workspace` delivers to whichever is active, which would type into a
    different session inside the right workspace."""
    if kind == "tmux":
        subprocess.run(["tmux", "send-keys", "-t", target, "-l", text],
                       check=True, timeout=20)
        subprocess.run(["tmux", "send-keys", "-t", target, "Enter"],
                       check=True, timeout=20)
        return
    subprocess.run(["cmux", "send", "--surface", target, text],
                   check=True, timeout=20)
    subprocess.run(["cmux", "send-key", "--surface", target, "enter"],
                   check=True, timeout=20)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--min-pct", type=float, default=None,
                    help="sweep every session at or above this fill. Ignored when "
                         "--session names one: a named session is compacted at any "
                         "fill, because asking for it IS the reason.")
    ap.add_argument("--go", action="store_true",
                    help="actually type; without it nothing is sent")
    ap.add_argument("--session", action="append", default=[],
                    help="restrict to these session ids (repeatable)")
    ap.add_argument("--ignore-dispatch", action="store_true",
                    help="act on an unattended pass even on a session whose last "
                         "recorded Stop reported dispatched work the transcript "
                         "cannot prove ended. A named session never needs it.")
    ap.add_argument("--limit", type=int, default=0,
                    help="stop after this many sessions actually typed into")
    args = ap.parse_args()

    spaces = workspaces()

    # How many LIVE sessions stand in each directory — the other half of the
    # ambiguity test above. Every session with a fill file counts, not only the
    # ones over the threshold: a session at 20% still occupies a pane.
    siblings = {}
    for f in glob.glob("/tmp/.ccctx-*"):
        other = os.path.basename(f)[len(".ccctx-"):]
        t = boundary_lib.transcript_of(other)
        c = cwd_of(t) if t else None
        if c:
            siblings[c] = siblings.get(c, 0) + 1

    # A NAMED SESSION IS COMPACTED AT ANY FILL. The percentage is how the hook
    # decides to act unprompted; naming a session here IS the decision, so a
    # threshold would only ever refuse the thing that was just asked for. It also
    # means a named session needs no fill reading at all — a parked pane that never
    # rendered still gets compacted, which is most of why this exists.
    named = bool(args.session)
    floor = args.min_pct if args.min_pct is not None else (0.0 if named else 70.0)

    targets = []
    seen = set()
    for f in glob.glob("/tmp/.ccctx-*"):
        sid = os.path.basename(f)[len(".ccctx-"):]
        if named and sid not in args.session:
            continue
        pct, age = fill(sid)
        if pct is None or pct < floor:
            continue
        seen.add(sid)
        targets.append((pct, age, sid))
    for sid in args.session:                  # named but with no fill file at all
        if sid not in seen:
            targets.append((-1.0, -1.0, sid))
    targets.sort(reverse=True)

    if not targets:
        print("nothing at or above %.0f%%" % floor)
        return 0

    typed = 0
    # Which explicitly-named sessions actually got a `/compact`. Named is a
    # REQUEST — the docstring above says asking for one IS the decision — so a
    # named session that ends the run untyped is a failed request and must
    # reach the caller as one. An unattended `--min-pct` sweep declining
    # sessions is this tool working correctly and stays exit 0.
    named = set(args.session)
    typed_named = set()
    for pct, age, sid in targets:
        head = "%5s  %s" % ("--" if pct < 0 else "%.0f%%" % pct, sid[:8])
        tpath = boundary_lib.transcript_of(sid)
        if not tpath:
            print("%s  SKIP  no transcript on disk" % head)
            continue

        # SETTLE, never NOTE: `dispatch_note` in `compaction.rs` reads the FIRST
        # "  NOTE  " line verbatim as the dispatch warning for a named fire, and
        # a settlement line sharing that literal would shadow it whenever both
        # fire on the same pass.
        settled, settled_detail = settle_pending(sid, tpath)
        if settled:
            print("%s  SETTLE  earlier sweep settled: %s (%s)" % (head, settled, settled_detail))
        if settled == "pending" and sid not in named:
            print("%s  SKIP  a swept /compact is still pending — %s" % (head, settled_detail))
            continue

        cwd = cwd_of(tpath)
        if not cwd:
            print("%s  SKIP  transcript records no cwd" % head)
            continue
        kind, target, why = surface_for(sid, cwd, spaces,
                                        siblings.get(cwd, 1),
                                        last_user_text(tpath))
        if not target:
            print("%s  SKIP  %s" % (head, why))
            continue
        dispatch, pending = dispatched_recently(sid, tpath)
        if args.ignore_dispatch:
            dispatch = None
        if dispatch and not named:
            print("%s  SKIP  %s — pass --ignore-dispatch to act anyway" % (head, dispatch))
            continue
        if dispatch:
            print("%s  NOTE  %s; named, so compacting anyway" % (head, dispatch))

        if not named:
            why_held = held_back(sid, pct, tpath)
            if why_held:
                print("%s  SKIP  %s" % (head, why_held))
                continue

        close = last_assistant_text(tpath)
        if not close.strip():
            print("%s  SKIP  no closing message to compose from" % head)
            continue

        f, r, how = focus_lib.compose(focus_lib.facts(cwd, pending, session=sid), close)
        print("%s  age=%-7s %s  how=%s"
              % (head, "?" if age < 0 else "%ds" % age, cwd, how))
        print("        focus  : %s" % f)
        print("        resume : %s" % (r or "(none — far side uses its own)"))
        if not args.go:
            print("        (dry run — nothing typed; pass --go)")
            continue

        # Taken BEFORE the send, exactly as the hook takes it: it marks where
        # this fire's evidence starts in the transcript, so nothing typed or
        # compacted earlier can settle it.
        pending = settle_lib.begin(pct, f, tpath, time.time())

        old_root = os.environ.get("HOOK_STATE_ROOT")
        try:
            handoff_lib.write(sid, r)
            type_into(kind, target, "/compact " + f)
        except Exception as exc:
            handoff_lib.clear(sid)
            print("        FAILED to type: %r" % exc)
            continue
        finally:
            if old_root is not None:
                os.environ["HOOK_STATE_ROOT"] = old_root
        print("        typed into %s:%s" % (kind, target))
        # The typist proves only that the keys reached the pane, never that a
        # compaction followed — measured lost 4 of 37 times on the same route
        # this sweeper types through. The fire spends nothing of the budget or
        # the cooldown until a later pass settles it against the transcript.
        st = sweep_state(sid)
        st["pending"] = pending
        _write_sweep_state(sid, st)
        typed += 1
        typed_named.add(sid)
        if args.limit and typed >= args.limit:
            print("\nstopped at --limit %d" % args.limit)
            break

    print("\n%d session(s) considered, %d typed into" % (len(targets), typed))

    # 🔴 THE EXIT CODE IS THE ONLY THING A NON-READING CALLER SEES: a button
    # that reports success or failure from this number alone. Returning 0 after
    # printing `SKIP no recorded seat` or `FAILED to type` tells that caller
    # the session was compacted when it was not — the same defect shape as
    # rendering an unread state as healthy.
    #
    # Only NAMED sessions count. `--go` is required to type at all, so a dry
    # run legitimately types nothing.
    if args.go and named:
        missed = sorted(named - typed_named)
        if missed:
            print("\nFAILED for %d named session(s): %s"
                  % (len(missed), ", ".join(s[:8] for s in missed)))
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
